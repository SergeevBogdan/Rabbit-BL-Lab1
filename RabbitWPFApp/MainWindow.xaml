<Window x:Class="RabbitWPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rabbit Management - MVVM" Height="600" Width="800"
        Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить" Click="LoadRabbits_Click" Margin="0,0,5,0"/>
            <Button Content="Добавить" Click="AddRabbit_Click" Margin="0,0,5,0"/>
            <Button Content="Удалить" Click="RemoveRabbit_Click" Margin="0,0,5,0"/>
            <Button Content="Обновить данные" Click="UpdateRabbit_Click" Margin="0,0,5,0"/>
            <Button Content="Случайный" Click="AddRandomRabbit_Click" Margin="0,0,5,0"/>
            <Button Content="Статистика" Click="ShowStatistics_Click" Margin="0,0,5,0"/>
            <Button Content="Детали" Click="ShowDetails_Click"/>
        </StackPanel>

        <!-- Список кроликов -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rabbits}" SelectedItem="{Binding SelectedRabbit}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Порода" Binding="{Binding Breed}" Width="120"/>
                <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="70"/>
                <DataGridTextColumn Header="Вес" Binding="{Binding Weight}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма добавления -->
        <GroupBox Grid.Row="2" Header="Добавить нового кролика" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <TextBox Grid.Column="1" Text="{Binding NewRabbit.Id}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="Имя:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Grid.Column="3" Text="{Binding NewRabbit.Name}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="Возраст:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Grid.Column="5" Text="{Binding NewRabbit.Age}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="Вес:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Grid.Column="7" Text="{Binding NewRabbit.Weight}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="8" Text="Порода:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Grid.Column="9" ItemsSource="{Binding Breeds}" SelectedItem="{Binding NewRabbit.Breed}"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="11" Content="Добавить" Click="AddRabbit_Click" 
                        Margin="10,0,0,0" Width="80"/>
            </Grid>
        </GroupBox>

        <!-- Статус View -->
        <TextBlock Grid.Row="3" x:Name="txtStatus" Text="{Binding StatusMessage}" 
                   Margin="0,5,0,5" FontWeight="Bold" Foreground="Blue"/>

        <!-- Общий статус -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" 
                   Margin="0,5,0,0" FontWeight="Bold" Foreground="Green"/>
    </Grid>
</Window>